IALERT_SYNC_SOURCE_DIR=
IALERT_BOOTSTRAP_ON_START=true
DEFAULT_DIESEL_COST_PER_LITRE=95
DEFAULT_EMISSION_FACTOR=2.68
DEFAULT_TANK_CAPACITY=300
