PORT=5000
MONGODB_URI=mongodb://localhost:27017/fleetx
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_MAPS_API_KEY=PASTE_YOUR_KEY_HERE
GOOGLE_DIRECTIONS_API_KEY=PASTE_YOUR_KEY_HERE

# iAlert manual file sync settings
IALERT_SYNC_TIMEZONE=Asia/Kolkata
